# ==============================================================================
# 🚀 SocialPilot AI - Example Environment Configuration (.env.example)
# ==============================================================================

NEXT_PUBLIC_APP_NAME="SocialPilot AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_TAGLINE="Create once. Publish everywhere. Manage everything."
NEXT_PUBLIC_DEMO_MODE="true"

TOKEN_ENCRYPTION_SECRET="your_32_character_encryption_secret_key_here"
META_WEBHOOK_VERIFY_TOKEN="socialpilot_webhook_secret_verify"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialpilot_db?schema=public"

# AI Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Meta (Facebook & Instagram)
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# X (Twitter)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Pinterest
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# Cloud Storage (AWS S3 / Cloudflare R2)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="socialpilot-media"
S3_REGION="auto"

# Billing
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
